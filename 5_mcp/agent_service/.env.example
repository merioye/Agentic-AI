GOOGLE_API_KEY=YOUR-GOOGLE-API-KEY

CHAT_MODEL=gemini-3.5-flash-lite

# devops server connection
DEVOPS_MCP_TRANSPORT=stdio          # "stdio" or "http"
DEVOPS_MCP_SERVER_PATH=../mcp_server/server.py
DEVOPS_MCP_URL=http://localhost:8001/mcp
DEVOPS_MCP_TOKEN=

# external filesystem server (requires Node.js + npx on PATH)
ENABLE_FILESYSTEM_SERVER=true
FILESYSTEM_ROOT=.

APP_NAME=MCP DevOps Agent
ENVIRONMENT=development
