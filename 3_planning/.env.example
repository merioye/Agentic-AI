# Copy to .env and fill in your key.

GOOGLE_API_KEY=YOUR-GOOGLE-API-KEY
PRIMARY_MODEL=gemini-3.1-pro
EXECUTOR_MODEL=gemini-3.5-flash-lite

MAX_REPLAN_CYCLES=4
MAX_PLAN_STEPS=10

MAX_MODEL_CALLS_PER_RUN=15

# LangSmith observability
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=YOUR-LANGSMITH-API_KEY
LANGSMITH_PROJECT="Agentic AI"