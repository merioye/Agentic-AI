# Copy to .env and fill in your key.

GOOGLE_API_KEY=YOUR-GOOGLE-API-KEY
# Must be a model that supports adaptive thinking.
PRIMARY_MODEL=gemini-3.5-pro
FAST_MODEL=gemini-3.5-flash-lite

# --- Effort routing ---
HEURISTIC_LENGTH_THRESHOLD=280
USE_LLM_CLASSIFIER_FALLBACK=true
DEFAULT_EFFORT=minimal

MAX_MODEL_CALLS_PER_RUN=15

# LangSmith observability
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=YOUR-LANGSMITH-API_KEY
LANGSMITH_PROJECT="Agentic AI"
