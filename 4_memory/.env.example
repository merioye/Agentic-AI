# Copy to .env and fill in your key.

GOOGLE_API_KEY=YOUR-GOOGLE-API-KEY

CHAT_MODEL=gemini-3.5-flash-lite
EMBEDDING_MODEL=gemini-embedding-001
EMBEDDING_DIMS=768

# "memory" for local dev, "postgres" for production
PERSISTENCE_BACKEND=memory
POSTGRES_DSN=postgresql://user:password@localhost:5432/support_agent

# "langmem" or "mem0"
MEMORY_BACKEND=langmem

APP_NAME=Support Agent
ENVIRONMENT=development

# LangSmith observability
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=YOUR-LANGSMITH-API_KEY
LANGSMITH_PROJECT="Agentic AI"