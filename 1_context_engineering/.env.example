# Copy this file to .env and fill in your key(s).

GOOGLE_API_KEY=YOUR-GOOGLE-API-KEY

PRIMARY_MODEL=gemini-3.5-pro
SUMMARIZER_MODEL=gemini-3.5-flash-lite

SQLITE_CHECKPOINT_PATH=./db/checkpoints.sqlite
APP_DB_PATH=./db/app.sqlite

MAX_MODEL_CALLS_PER_RUN=25
SUMMARIZE_AFTER_TOKENS=2000

# LangSmith observability
LANGSMITH_TRACING_V2=true
LANGSMITH_ENDPOINT=https://api.smith.langchain.com
LANGSMITH_API_KEY=YOUR-LANGSMITH-API_KEY
LANGSMITH_PROJECT="Agentic AI"
