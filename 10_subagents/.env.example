# Copy this file to .env and fill in real values. Never commit .env itself.

GOOGLE_API_KEY=YOUR-GOOGLE-API-KEY
SUPERVISOR_MODEL=gemini-3.1-pro
SUBAGENT_MODEL=gemini-3.5-flash-lite

# Static key clients must send as the X-API-Key header
API_KEY=change-me-to-a-long-random-string

MAX_AGENT_STEPS=15
REQUEST_TIMEOUT_SECONDS=30

LANGSMITH_TRACING=true
LANGSMITH_API_KEY=YOUR-LANGSMITH-API-KEY
LANGSMITH_PROJECT="Agentic AI"

LOG_LEVEL=INFO
